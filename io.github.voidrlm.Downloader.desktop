[Desktop Entry]
Type=Application
Name=Downloader
GenericName=Torrent and Download Manager
Comment=Download torrents, magnet links and direct links fast
Exec=downloader %U
Icon=io.github.voidrlm.Downloader
Terminal=false
Categories=Network;FileTransfer;P2P;GTK;
